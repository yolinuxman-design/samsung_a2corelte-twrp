# TWRP recovery.fstab - pulled from device
/system          ext4      /dev/block/platform/13540000.dwmmc0/by-name/SYSTEM
/vendor          ext4      /dev/block/platform/13540000.dwmmc0/by-name/VENDOR
/cache           ext4      /dev/block/platform/13540000.dwmmc0/by-name/CACHE
/data            f2fs      /dev/block/platform/13540000.dwmmc0/by-name/USERDATA      flags=encryptable=footer;length=-20480
/boot            emmc      /dev/block/platform/13540000.dwmmc0/by-name/BOOT
/recovery        emmc      /dev/block/platform/13540000.dwmmc0/by-name/RECOVERY
/misc            emmc      /dev/block/platform/13540000.dwmmc0/by-name/MISC
/efs             ext4      /dev/block/platform/13540000.dwmmc0/by-name/EFS
/cpefs           ext4      /dev/block/platform/13540000.dwmmc0/by-name/CPEFS
/odm             ext4      /dev/block/platform/13540000.dwmmc0/by-name/ODM
/modem           emmc      /dev/block/platform/13540000.dwmmc0/by-name/RADIO
/preload         ext4      /dev/block/platform/13540000.dwmmc0/by-name/HIDDEN
/external_sd     vfat      /dev/block/mmcblk1p1                                        flags=display="SD Card";storage;wipeingui;removable
