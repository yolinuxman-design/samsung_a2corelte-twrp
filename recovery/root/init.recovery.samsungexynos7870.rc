on init
    write /proc/sys/kernel/hung_task_timeout_secs 0
    # Set library path so vendor HALs can find their dependencies
    export LD_LIBRARY_PATH /vendor/lib:/system/lib

on fs
    mount none /system/vendor /vendor bind

on boot
    chmod 0660 /dev/input/event*
    chown system system /dev/input/event*
    chmod 0666 /dev/graphics/fb0

    # Load crc32 module if you included it as a prebuilt module (only if kernel was not rebuilt)
    # insmod /lib/modules/crc32.ko
    # insmod /lib/modules/crc32c.ko

    start servicemanager
    start hwservicemanager
    start keymaster-3-0
    start gatekeeper-1-0

on post-fs-data
    mkdir /efs/DAK 0775 system system
    restorecon -R /efs/DAK

# Use /sbin/ paths for core recovery binaries
service servicemanager /sbin/servicemanager
    class core
    user system
    group system
    critical
    seclabel u:r:recovery:s0

service hwservicemanager /sbin/hwservicemanager
    class early_hal
    user system
    group system
    critical
    seclabel u:r:recovery:s0

service keymaster-3-0 /vendor/bin/hw/android.hardware.keymaster@3.0-service
    class early_hal
    user system
    group system drmrpc
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class early_hal
    user system
    group system
    seclabel u:r:recovery:s0
